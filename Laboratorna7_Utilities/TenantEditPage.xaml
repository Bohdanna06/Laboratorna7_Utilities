<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Laboratorna7_Utilities.TenantEditPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Особовий рахунок" />
            <Entry x:Name="AccountEntry" />

            <Label Text="ПІБ" />
            <Entry x:Name="NameEntry" />

            <Label Text="Адреса" />
            <Entry x:Name="AddressEntry" />

            <Label Text="Кількість мешканців" />
            <Entry x:Name="OccupantsEntry" Keyboard="Numeric" />

            <Label Text="Площа (м²)" />
            <Entry x:Name="AreaEntry" Keyboard="Numeric" />

            <Button x:Name="ServicesButton"
                    Text="📋 Послуги та нарахування"
                    Clicked="OnServicesClicked" />
            <Button Text="💾 Зберегти" Clicked="OnSaveClicked" />
            <Button x:Name="DeleteButton"
                    Text="🗑 Видалити"
                    BackgroundColor="Firebrick"
                    Clicked="OnDeleteClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>