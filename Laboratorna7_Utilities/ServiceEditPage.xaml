<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Laboratorna7_Utilities.ServiceEditPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Назва послуги" />
            <Entry x:Name="NameEntry" />

            <Label Text="Тариф за м² (залиш порожнім, якщо не застосовується)" />
            <Entry x:Name="SqMeterEntry" Keyboard="Numeric" />

            <Label Text="Тариф за особу (залиш порожнім, якщо не застосовується)" />
            <Entry x:Name="PersonEntry" Keyboard="Numeric" />

            <Button Text="💾 Зберегти" Clicked="OnSaveClicked" />
            <Button x:Name="DeleteButton"
                    Text="🗑 Видалити"
                    BackgroundColor="Firebrick"
                    Clicked="OnDeleteClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>