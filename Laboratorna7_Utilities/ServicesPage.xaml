<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Laboratorna7_Utilities.ServicesPage"
             Title="Послуги">

    <Grid RowDefinitions="Auto,*" Padding="15" RowSpacing="10">

        <Button Text="➕ Додати послугу" Clicked="OnAddClicked" />

        <CollectionView x:Name="ServicesView"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnServiceSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,4" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout>
                            <Label Text="{Binding ServiceName}" FontAttributes="Bold" />
                            <Label Text="{Binding RatePerSqMeter, StringFormat='Тариф за м²: {0}'}" />
                            <Label Text="{Binding RatePerPerson, StringFormat='Тариф за особу: {0}'}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>