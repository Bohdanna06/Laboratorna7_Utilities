<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Laboratorna7_Utilities.MainPage"
             Title="Мешканці">

    <Grid RowDefinitions="Auto,*" Padding="15" RowSpacing="10">

        <Button Text="➕ Додати мешканця"
                Clicked="OnAddClicked" />

        <CollectionView x:Name="TenantsView"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnTenantSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,4" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout>
                            <Label Text="{Binding FullName}" FontAttributes="Bold" />
                            <Label Text="{Binding AccountNumber, StringFormat='Рахунок: {0}'}" />
                            <Label Text="{Binding Address}" />
                            <Label Text="{Binding Area, StringFormat='Площа: {0} м²'}" />
                            <Label Text="{Binding OccupantsCount, StringFormat='Мешканців: {0}'}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>